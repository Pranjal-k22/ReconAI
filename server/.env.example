PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Required in development and production modes:
MONGODB_URI=

# Optional features:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_MODE=test
RAZORPAY_REQUEST_TIMEOUT_MS=10000
RAZORPAY_WEBHOOK_SECRET=

DEMO_MODE=true
# Optional Payment Monitoring (Phase 5)
MONITORING_WORKER_ENABLED=true
MONITORING_INTERVAL_MS=30000
MONITORING_LEASE_DURATION_MS=30000
MONITORING_MAX_CONCURRENT_READS=5
MONITORING_MAX_ATTEMPTS=4
MONITORING_DEADLINE_MINUTES=60
